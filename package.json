{
  "name": "daily-commit",
  "private": true,
  "version": "0.1.0",
  "description": "A private, local-first habit tracker, day planner and diary.",
  "type": "module",
  "scripts": {
    "watch": "vite build --watch",
    "preview": "vite preview --host 127.0.0.1 --port 8310 --strictPort",
    "build": "vite build && node scripts/release-check.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test",
    "screens:build": "vite build --config vite.harness.config.ts",
    "screens": "npm run screens:build && node scripts/screens/flows.mjs",
    "screens:shots": "npm run screens:build && node scripts/screens/shots.mjs",
    "screens:gate": "npm run screens:build && node scripts/screens/gate.mjs",
    "screens:compare": "npm run screens:build && node scripts/screens/compare.mjs",
    "android:build": "node scripts/android/build.ts release",
    "android:test": "node scripts/android/build.ts test",
    "android:check": "node scripts/android/apk-check.ts",
    "android:emulator": "node scripts/android/emulator.ts",
    "android:smoke": "node scripts/android/smoke.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "apca-w3": "^0.1.9",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "odiff-bin": "^4.5.0",
    "playwright-core": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
