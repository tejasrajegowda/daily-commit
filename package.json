{
  "name": "daily-commit",
  "private": true,
  "version": "0.1.0",
  "description": "A private, local-first habit tracker, day planner and diary.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8310",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
